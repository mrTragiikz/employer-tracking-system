# Real secrets - never commit (DB credentials, APP_URL, APP_SECRET, Mapbox
# token - see secure_config/secure_config.php). Copy it by hand to the live
# server. secure_config.example.php (the sanitised template) IS tracked, and
# so is that folder's .htaccess (the safety net, not a secret).
/secure_config/secure_config.php
/secure_config/secure_config.local.php

# Runtime
/logs/*
!/logs/.htaccess

# Uploaded photos (real captures never committed; demo placeholders are kept)
/uploads/*
!/uploads/.htaccess
!/uploads/demo/
/uploads/demo/*
!/uploads/demo/*.jpg

# Dependencies (if Composer is added later)
/vendor/

# Deploy bundle / archives - a rebuilt copy of the tree, never tracked
/track.zip
*.zip

# Claude Code local session state (memory index + per-project settings live
# under the user's home, not here - this is just any stray local config)
/.claude/settings.local.json

# One-off diagnostic / cleanup scripts - must never reach a live server OR git
/_diag*.php
/wipe_*.php
/test.php

# Database dumps taken for inspection (schema of record is sql/database.sql)
/*_track.sql
/*.sql.gz

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/
*.swp
