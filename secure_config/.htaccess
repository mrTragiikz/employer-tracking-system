# Never serve secrets over HTTP. This is a second layer of defense only -
# the real protection is moving this whole folder outside public_html on
# the live server (see DEPLOY.md, section 2).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
